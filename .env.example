DATABASE_URL=postgresql://postgres:postgres@localhost:5548/financial_control_v2
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5548/financial_control_v2_test
# Runtime da aplicacao: role nao-superuser app_user (RLS enforced).
# DATABASE_URL (postgres/superuser) fica para tooling: drizzle-kit, scripts, backups.
APP_DATABASE_URL=postgresql://app_user:app_user@localhost:5548/financial_control_v2
# REQUIRED. Generate a real secret (32+ hex chars) with:
#   openssl rand -hex 32
# PowerShell alternative:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The app refuses to boot with a placeholder or low-entropy value
# (validator: apps/web/src/lib/env.ts strongSecret). Never commit the real value.
BETTER_AUTH_SECRET=replace-me
NEXT_PUBLIC_APP_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3001
# Set to 'true' in production to block new account registration
AUTH_DISABLE_SIGNUP=false
# Enable only after the S05 migration and HTTPS deployment are ready.
CAPTURE_ANDROID_ENABLED=false
# Personal MeuPluggy only; configure after reviewing the Open Finance runbook.
PLUGGY_ENABLED=false
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_PERSONAL_ITEMS=[]
PLUGGY_WEBHOOK_SECRET=
INTEGRATION_SCHEDULER_DATABASE_URL=
CRON_SECRET=
